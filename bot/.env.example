PORT=3001
NODE_ENV=production

# Supabase (depuis votre tableau de bord Supabase > Project Settings > API)
SUPABASE_URL=https://votre-projet.supabase.co
# Utilisez la clé Service Role (secrète) pour permettre au bot en arrière-plan d'écrire sans blocage RLS
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optionnel : ID utilisateur cible si instance dédiée
BOT_USER_ID=

# Chemin du stockage persistant des sessions WhatsApp (sur Railway / Render / VPS monter un volume ici)
SESSION_DATA_PATH=/app/sessions
